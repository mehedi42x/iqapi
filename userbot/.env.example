# =============================================================================
# IQ Option Userbot  —  copy to .env and fill in.  NEVER commit real passwords.
# Every value below can be changed without touching code.
# =============================================================================

# --- credentials (never hardcode these in .py files) -------------------------
IQ_EMAIL=your_email@example.com
IQ_PASSWORD=your_password

# PRACTICE  |  REAL
# Real-money trading also requires IQ_ALLOW_REAL=true
IQ_ACCOUNT_MODE=PRACTICE
IQ_ALLOW_REAL=false

# --- market ------------------------------------------------------------------
# Asset / symbol. Gold aliases: XAUUSD, GOLD, XAU/USD
# OTC weekend pairs: EURUSD-OTC, GBPUSD-OTC, ...
ASSET=EURUSD

# If the spot market is closed, try ASSET-OTC automatically
OTC_FALLBACK=true

# 1m  5m  15m  30m  1h  4h   or raw seconds (60, 300, ...)
TIMEFRAME=1m

# binary | turbo | digital | blitz
TRADE_TYPE=binary

# Option expiry.  binary/digital = minutes.  blitz = seconds (5/10/15/30/60)
DURATION=1

# Use turbo-option wire for short binary expiries (auto = duration <= 5 min)
TURBO=auto

# --- strategy ----------------------------------------------------------------
# Module name (filename without .py) or a path to a custom .py file
# Built-in:
#   binary1, binary_sniper
#   digital1, digital_ai
#   blitz_flash, blitz_snap
#   gold_scalp, gold_breakout, gold_impulse, gold_session
#   auto   -> pick a sensible default from TRADE_TYPE + ASSET
STRATEGY=auto

# Ignore signals weaker than this (0.00 - 1.00)
MIN_CONFIDENCE=0.62

# --- money -------------------------------------------------------------------
AMOUNT=1
# fixed | percent | martingale | anti_martingale
MM_MODE=fixed
# used when MM_MODE=percent  (percent of current balance)
MM_PERCENT=1.5
MARTINGALE_FACTOR=2.0
MARTINGALE_STEPS=2

# --- risk / session guards ---------------------------------------------------
MIN_PAYOUT=70
MAX_TRADES=80
MAX_DAILY_LOSS=25
MAX_DAILY_PROFIT=80
MAX_CONSECUTIVE_LOSSES=4
MAX_OPEN_POSITIONS=1
COOLDOWN_SECONDS=4
# wait for the candle to close before analysing (recommended)
TRADE_ON_CLOSE=true
# generate signals but never send an order
DRY_RUN=false
# wait for expiry before the next trade (keeps MAX_OPEN_POSITIONS honest)
WAIT_RESULT=true

# assumed payout when the live book is unavailable (also used by backtest)
PAYOUT_PERCENT=80

# --- engine ------------------------------------------------------------------
CANDLE_COUNT=220
LOG_LEVEL=INFO
# reconnect / retry — the engine never blocks forever
REQUEST_TIMEOUT=25
RECONNECT_DELAY=3
MAX_FETCH_RETRIES=4
HEARTBEAT_SECONDS=60
